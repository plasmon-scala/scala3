package build

import mill.*
import mill.javalib.publish.*
import mill.scalalib.*
import mill.util.VcsVersion

object `presentation-compiler` extends SbtModule with PublishModule {
  def sources = Task.Sources(os.sub / "src/main")
  def scalaVersion = "3.8.1"
  private def mtagsVersion = "1.6.5-3"
  def mvnDeps = Seq(
    mvn"com.lihaoyi::pprint:0.8.1",
    mvn"org.lz4:lz4-java:1.8.0",
    mvn"io.get-coursier:interface:1.0.18",
    mvn"io.github.plasmon-scala:mtags-interfaces:$mtagsVersion"
      .exclude(("org.eclipse.lsp4j", "org.eclipse.lsp4j"))
      .exclude(("org.eclipse.lsp4j", "org.eclipse.lsp4j.jsonrpc")),
    mvn"io.github.plasmon-scala:mtags_2.13.18:$mtagsVersion"
      .exclude(("com.lihaoy", "pprint_2.13")),
    mvn"org.eclipse.lsp4j:org.eclipse.lsp4j:1.0.0",
    mvn"org.scala-lang:scala3-compiler_3:${scalaVersion()}"
  )
  def scalacOptions = super.scalacOptions() ++ Seq(
    "-source", "3.3", "-Yexplicit-nulls", "-Wsafe-init"
  )

  def artifactName = "scala3-presentation-compiler"
  def publishVersion = Task {
    val ver = VcsVersion.vcsState().format(untaggedSuffix = "-SNAPSHOT")
    val dirtyIdx = ver.indexOf("-DIRTY")
    if (dirtyIdx < 0) ver
    else ver.take(dirtyIdx) + "-SNAPSHOT"
  }
  def pomSettings = PomSettings(
    description = "scala3-presentation-compiler",
    organization = "io.github.plasmon-scala",
    url = s"https://github.com/plasmon-scala/scala3",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("plasmon-scala", "scala3"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault"),
    )
  )
}
